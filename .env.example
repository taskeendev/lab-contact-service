SERVER_PORT=8084

POSTGRES_DB=contactdb
POSTGRES_USER=contact
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5435

DB_URL=jdbc:postgresql://localhost:5435/contactdb
DB_USER=contact
DB_PASSWORD=change-me

JWT_SECRET=must-match-auth-service-secret

# SMTP เจ้าไหนก็ได้ (Gmail app password / Resend / Mailgun ฯลฯ)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
# อีเมลแจ้งเตือนเด้งไปหาใคร / ส่งในนามใคร
CONTACT_NOTIFY_TO=you@example.com
CONTACT_NOTIFY_FROM=lab@example.com
